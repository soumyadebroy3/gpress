{
  "name": "gpress",
  "version": "0.1.0",
  "private": true,
  "description": "Lossless PDF compression in the browser and Node: smaller PDFs that any reader opens, and the gpress archive that restores byte for byte.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/gpress.js",
  "types": "./dist/gpress.d.ts",
  "exports": {
    ".": { "types": "./dist/gpress.d.ts", "import": "./dist/gpress.js" },
    "./gpress.wasm": "./dist/gpress.wasm"
  },
  "files": ["dist/"],
  "scripts": {
    "build:wasm": "node build-wasm.mjs",
    "build:js": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:js",
    "test": "node --test test/"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
